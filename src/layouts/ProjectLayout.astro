---
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import { projectPath, type Project } from '@/lib/projects';
import { site } from '@/site';

interface Props {
  project: Project;
  next: Project;
  wrapsToFirst: boolean;
}

const { project, next, wrapsToFirst } = Astro.props;
const {
  title,
  kicker,
  summary,
  year,
  role,
  stack,
  kind,
  liveUrl,
  sourceUrl,
  deploymentStatus,
  gallery,
  galleryIntro,
} = project.data;

const status = liveUrl ? 'Live demo available' : deploymentStatus;
const application = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  description: summary,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: new URL(projectPath(project), Astro.site).href,
  ...(liveUrl && { installUrl: liveUrl }),
  ...(sourceUrl && { codeRepository: sourceUrl }),
  author: { '@type': 'Person', name: site.name, url: Astro.site?.href },
  dateCreated: String(year),
};
---

<BaseLayout title={`${title} — ${site.name}`} description={summary} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(application)} />
  <article class="case-study">
    <header class="case-hero page-shell">
      <a class="back-link" href="/#work"><span aria-hidden="true">←</span> Selected work</a>
      <div class="case-hero__grid">
        <div>
          <p class="eyebrow">{kicker}</p>
          <h1>{title}</h1>
          <p class="case-hero__summary">{summary}</p>
          <div class="case-actions">
            {liveUrl ? <a class="button button--dark" href={liveUrl} target="_blank" rel="noreferrer">Open live demo <span aria-hidden="true">↗</span></a> : <span class="button button--muted"><i></i>{deploymentStatus}</span>}
            {sourceUrl && <a class="text-link" href={sourceUrl} target="_blank" rel="noreferrer">View source <span aria-hidden="true">↗</span></a>}
          </div>
        </div>
        <dl class="case-facts">
          <div><dt>Status</dt><dd>{status}</dd></div>
          <div><dt>Year</dt><dd>{year}</dd></div>
          <div><dt>Role</dt><dd>{role}</dd></div>
          <div><dt>Stack</dt><dd>{stack}</dd></div>
        </dl>
      </div>
    </header>
    <div class="page-shell case-visual-wrap"><ProjectVisual kind={kind} /></div>
    <div class="case-body page-shell">
      <slot />
    </div>
    {gallery && (
      <section class="case-gallery page-shell" aria-labelledby="gallery-heading">
        <h2 id="gallery-heading">Screens from the demo</h2>
        {galleryIntro && <p class="case-gallery__intro">{galleryIntro}</p>}
        <div class="case-gallery__grid">
          {gallery.map((item) => (
            <figure>
              <a class="case-gallery__frame" href={item.src.src} target="_blank" rel="noreferrer" aria-label={`Open the full-size screenshot: ${item.caption}`}>
                <Picture src={item.src} formats={['avif', 'webp']} widths={[560, 840, 1120]} sizes="(max-width: 980px) 100vw, 570px" alt={item.alt} loading="lazy" />
              </a>
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
    <aside class="next-project page-shell">
      <p class="eyebrow">Continue exploring</p>
      <a href={projectPath(next)}><span>{wrapsToFirst ? 'Back to first project' : 'Next project'}</span><strong>{next.data.title}</strong><i aria-hidden="true">↗</i></a>
    </aside>
  </article>
</BaseLayout>
