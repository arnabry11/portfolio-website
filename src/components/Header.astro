---
import { Image } from 'astro:assets';
import avatar from '@/assets/arnab-roy-avatar.jpg';
import ContactDialog from '@/components/ContactDialog.astro';
import { site } from '@/site';

const currentPath = Astro.url.pathname;
const onHome = currentPath === '/';
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      <Image class="wordmark__avatar" src={avatar} width={34} height={34} densities={[1, 2, 3]} format="webp" alt="" loading="eager" />
      <span class="wordmark__name">{site.name}</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href={onHome ? '#work' : '/#work'}>Work</a>
      <a href={onHome ? '#consulting' : '/#consulting'}>Consulting</a>
      <a href={onHome ? '#experience' : '/#experience'}>Experience</a>
      <a href={onHome ? '#about' : '/#about'}>About</a>
      <a class="site-nav__contact" href={`mailto:${site.email}`} aria-haspopup="dialog" data-contact-trigger>Let’s talk <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
  <ContactDialog />
</header>
