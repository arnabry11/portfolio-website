---
import ProjectVisual from '@/components/ProjectVisual.astro';
import { projectPath, type Project } from '@/lib/projects';

interface Props {
  project: Project;
  reverse?: boolean;
}

const { project, reverse = false } = Astro.props;
const { order, title, kicker, kind, liveUrl, deploymentStatus, card } = project.data;
const href = projectPath(project);
---

<article class:list={['project-card', `project-card--${kind}`, { 'project-card--reverse': reverse }]}>
  <a class="project-card__visual-link" href={href} aria-label={`Read the ${title} case study`}><ProjectVisual kind={kind} compact /></a>
  <div class="project-card__copy">
    <div class="project-card__meta"><span>{String(order).padStart(2, '0')}</span><span>{card.stack}</span></div>
    <p class="eyebrow">{kicker}</p>
    <h3><a href={href}>{title}</a></h3>
    <p>{card.summary}</p>
    <ul class="project-points">{card.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
    <div class="project-card__actions">
      {liveUrl ? (
        <>
          <a class="button button--dark button--small" href={liveUrl} target="_blank" rel="noreferrer">Try the live demo <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={href}>Case study</a>
        </>
      ) : (
        <>
          <a class="text-link" href={href}>Read case study <span aria-hidden="true">↗</span></a>
          <span class="status-pill"><i></i> {deploymentStatus}</span>
        </>
      )}
    </div>
  </div>
</article>
