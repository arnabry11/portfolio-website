---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { Picture } from 'astro:assets';
import portrait from '@/assets/arnab-roy-portrait.jpg';
import { getProjects } from '@/lib/projects';
import { site } from '@/site';

const projects = await getProjects();
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  url: Astro.site?.href,
  image: new URL(portrait.src, Astro.site).href,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Dhanbad', addressCountry: 'IN' },
  sameAs: Object.values(site.links),
};
---

<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <section class="hero page-shell">
    <div class="hero__availability"><i></i> Software engineer · Dhanbad, India</div>
    <h1>From your idea to <em>working software.</em></h1>
    <div class="hero__footer">
      <p>I’m Arnab, a software engineer with 7+ years of experience. I help businesses turn ideas into web applications, internal tools, and automated workflows. From planning and development to deployment, I take responsibility for bringing the pieces together.</p>
      <div class="hero__actions">
        <a class="button button--dark" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={site.resume}>View résumé <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="impact-band" aria-label="What you can expect">
    <div class="page-shell impact-band__grid">
      <div><strong>7+ years in production</strong><span>Building, running, and fixing software that real businesses depend on every day.</span></div>
      <div><strong>Built for high traffic</strong><span>Backend systems that process tens of thousands of leads a day, with background jobs that keep up.</span></div>
      <div><strong>Reliable integrations</strong><span>Retry-safe syncing between payments, e‑signatures, and revenue data, so a failed call never loses or duplicates anything.</span></div>
      <div><strong>Fast, tested releases</strong><span>Fast unit and integration tests that let changes go out with confidence. I once cut a two-hour suite to 30 minutes.</span></div>
    </div>
  </section>

  <section class="work page-shell" id="work">
    <div class="section-heading">
      <p class="eyebrow">01 / Selected work</p>
      <h2>Ideas brought<br />to life in code.</h2>
      <p>Explore the applications I’ve built, the problems they solve, and how they work—from business operations and documentation search to EV charging.</p>
    </div>

    {projects.map((project, index) => <ProjectCard project={project} reverse={index % 2 === 1} />)}
  </section>

  <section class="consulting-wrap" id="consulting">
    <div class="consulting page-shell">
      <div class="section-heading section-heading--compact">
        <p class="eyebrow">02 / Consulting</p>
        <h2>Advice that ends in<br />working software.</h2>
      </div>
      <div class="consulting__grid">
        <article class="consulting__track">
          <p class="eyebrow">AI for your business</p>
          <h3>You have the AI subscription. Now put it to work.</h3>
          <p>Most teams already pay for AI tools, but the way the work gets done hasn’t changed. I help you find where AI genuinely saves time, then build it into the processes you already run.</p>
          <ul>
            <li><strong>Find where it pays off.</strong> Walk through support, reporting, document handling, and follow-ups to pick the few processes worth automating.</li>
            <li><strong>Build it into the workflow.</strong> Assistants that answer from your own documents with cited sources, and automations that connect your existing tools.</li>
            <li><strong>Make it dependable.</strong> Test on real examples, handle failures, control cost and data access, and show your team how to use it.</li>
          </ul>
          <div class="consulting__actions">
            <a class="button button--dark" href={`mailto:${site.email}?subject=${encodeURIComponent('AI for my business')}`}>Talk through your processes <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="/projects/ask-the-docs/">Example: Ask the Docs <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <article class="consulting__track">
          <p class="eyebrow">Software consulting</p>
          <h3>Senior backend judgment, when you need it.</h3>
          <p>Whether you’re planning something new or untangling something that already exists, I bring seven years of production experience to the decisions that are hardest to undo.</p>
          <ul>
            <li><strong>Architecture and planning.</strong> Scope a first version, shape the data model, and choose a technical approach before code is written.</li>
            <li><strong>Reviews and performance.</strong> Find the slow queries, flaky background jobs, and long test suites holding your team back, then fix them.</li>
            <li><strong>Deployment and infrastructure.</strong> Docker and AWS setup across EC2, ECS, Route 53, and load balancing, with a path to reliable releases.</li>
          </ul>
          <div class="consulting__actions">
            <a class="button button--dark" href={`mailto:${site.email}?subject=${encodeURIComponent('Software consulting')}`}>Discuss your project <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#experience">See my experience <span aria-hidden="true">↓</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="principles-wrap">
    <div class="principles page-shell">
      <div class="section-heading section-heading--compact">
        <p class="eyebrow">03 / From idea to launch</p>
        <h2>One engineer.<br />The whole journey.</h2>
      </div>
      <div class="principles__grid">
        <article><span>01</span><h3>Shape the first version</h3><p>Start with the problem, the people using the application, and the workflows that matter. Turn those requirements into a practical scope, a data model, and a technical plan.</p></article>
        <article><span>02</span><h3>Build the application</h3><p>Connect the interface, business logic, data, and integrations into working software. My backend expertise and AI-assisted frontend workflow let me take responsibility for both sides, with clear code conventions and review.</p></article>
        <article><span>03</span><h3>Launch and improve</h3><p>Deploy the application and configure the infrastructure it needs to run. I work with Docker and AWS—including EC2, ECS, Route 53, and load balancers—and bring production experience in performance and reliability.</p></article>
      </div>
    </div>
  </section>

  <section class="experience page-shell" id="experience">
    <div class="section-heading section-heading--compact">
      <p class="eyebrow">04 / Experience</p>
      <h2>Seven years of building and improving production software.</h2>
    </div>
    <div class="timeline">
      <article class="timeline__item timeline__item--featured"><div class="timeline__date">2026 — now</div><div><p>Iksha Labs · Remote</p><h3>Sr. Associate Lead — L3</h3><p class="timeline__detail">Leading backend development for a lead-bidding and campaign analytics platform processing 60–70K leads a day. Set engineering conventions for a four-person backend team and built retry-safe revenue synchronization across four brands.</p></div><span class="timeline__current">Current</span></article>
      <article class="timeline__item"><div class="timeline__date">2024 — 2026</div><div><p>Coffeebeans · Remote</p><h3>Software Development Engineer</h3><p class="timeline__detail">Built web applications and cloud services for insurance marketing data flows, including large-file processing on AWS Lambda and Fargate.</p></div></article>
      <article class="timeline__item"><div class="timeline__date">2022 — 2024</div><div><p>GrowthTribe · Remote</p><h3>Backend Engineer</h3><p class="timeline__detail">Developed Rails and GraphQL systems, optimized PostgreSQL and Sidekiq workloads, implemented subscriptions with Stripe, and mentored junior engineers.</p></div></article>
      <article class="timeline__item"><div class="timeline__date">2020 — 2022</div><div><p>Rently · Kolkata</p><h3>Ruby on Rails Developer</h3><p class="timeline__detail">Worked on system design, IoT communication, SQS processing, Rails upgrades, and reduced a two-hour test suite to 30 minutes.</p></div></article>
      <article class="timeline__item"><div class="timeline__date">2019 — 2020</div><div><p>Kreeti Technologies · Kolkata</p><h3>Full Stack Engineer</h3><p class="timeline__detail">Integrated DocuSign and improved web applications for speed, scalability, and security.</p></div></article>
    </div>
  </section>

  <section class="about page-shell" id="about">
    <div class="about__label">
      <p class="eyebrow">05 / About</p>
      <Picture
        class="about__portrait"
        src={portrait}
        formats={['avif', 'webp']}
        widths={[300, 600, 900]}
        sizes="(max-width: 700px) 260px, (max-width: 980px) 20vw, 300px"
        alt="Arnab Roy at a desk in a home office, with code open on a monitor behind"
      />
    </div>
    <div class="about__copy">
      <h2>Your idea needs someone who can see it through.</h2>
      <p>I’m a software engineer based in Dhanbad, India. I enjoy connecting a business problem to the technical decisions that make an application work. Whether I’m building a product independently or working within a team, I take responsibility for how the pieces fit together.</p>
      <p>Backend engineering is my deepest expertise: Rails, PostgreSQL, APIs, integrations, and reliable background processing. My earlier React experience gives me a foundation for frontend work; today I use AI assistance for interface implementation and visual design, while guiding the structure and reviewing the code.</p>
      <p>I also handle application deployment on AWS, from compute and containers to DNS and load balancing. That combination lets me carry an idea from a technical plan to a working application and its deployment. Niyojan shows the breadth of my implementation work: I built both its frontend and backend.</p>
      <div class="about__skills"><span>Ruby on Rails</span><span>PostgreSQL</span><span>Python</span><span>Go</span><span>Redis</span><span>GraphQL</span><span>React · AI-assisted</span><span>Docker</span><span>AWS EC2</span><span>AWS ECS</span><span>Route 53</span><span>Load balancing</span></div>
      <div class="about__links"><a class="button button--dark" href={`mailto:${site.email}`}>Let’s discuss your idea <span aria-hidden="true">↗</span></a><a class="text-link" href={site.resume}>Download résumé <span aria-hidden="true">↓</span></a></div>
    </div>
  </section>
</BaseLayout>
